# Salin ke .env di server (chmod 600). JANGAN commit .env.
# Dibaca docker-compose.yml. Lihat docs/DEPLOYMENT.md.

# --- Dibaca saat BUILD (di-inline ke bundle; ubah = build ulang image) ---
# URL publik API Supabase yang diakses browser (lewat reverse proxy, HTTPS).
NEXT_PUBLIC_SUPABASE_URL=https://api.example.go.id
# Anon key (aman publik; tetap dibatasi RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publik situs ini, tanpa slash akhir. Dipakai CSRF check logout, link
# undangan user, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://example.go.id

# --- Dibaca saat RUNTIME (server-only, tidak masuk image) ---
SUPABASE_SERVICE_ROLE_KEY=
# URL Supabase lewat jaringan Docker internal. Disarankan diisi di produksi:
# http://kong:8000  (dan WAJIB bila edge memblokir /rest/v1/rpc/, lihat docs/DEPLOYMENT.md)
SUPABASE_INTERNAL_URL=http://kong:8000
# Nama jaringan Docker stack Supabase (docker network ls).
SUPABASE_NETWORK=supabase-project_default
GOOGLE_TRANSLATE_API_KEY=
# Secret untuk POST /api/revalidate (header: Authorization: Bearer <secret>).
# Buat acak: openssl rand -hex 32
REVALIDATE_SECRET=
